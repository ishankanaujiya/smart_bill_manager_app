<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- OneSignal tints the Android small notification icon with this colour on
         Android 12 (API 31) and newer. The value is ARGB hex with no leading
         '#', and matches the app's brand teal (#14B8A6). The OneSignal SDK
         reads this resource directly, so no manifest entry is needed. -->
    <string name="onesignal_notification_accent_color">FF14B8A6</string>
</resources>
