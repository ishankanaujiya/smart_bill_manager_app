rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------
    // USERS
    // -------------------------
    match /users/{userId} {

      // Any authenticated user can read any user document and list the
      // collection. The list permission is required for the member-search
      // flow (prefix queries on `email` / `phone_number`) when creating a
      // group.
      allow read: if request.auth != null;

      // A user can only create / update / delete their own document.
      allow create: if request.auth != null
        && request.auth.uid == userId;

      allow update: if request.auth != null
        && request.auth.uid == userId;

      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }


    // -------------------------
    // GROUPS
    // -------------------------
    match /groups/{groupId} {

      // Only authenticated users can create groups,
      // and the creator must be the group owner.
      allow create: if request.auth != null
        && request.resource.data.created_by == request.auth.uid
        && request.resource.data.member_ids is list
        && request.auth.uid in request.resource.data.member_ids;


      // Only group members can read the group.
      allow read: if request.auth != null
        && request.auth.uid in resource.data.member_ids;


      // Only group owner/admin can update.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.created_by;


      // Only group owner/admin can delete.
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.created_by;


      // -------------------------
      // BILLS (subcollection)
      // -------------------------
      // Bills live under groups/{groupId}/bills/{billId}.
      // Any group member can create a bill. Any group member can read,
      // update, or delete bills. The parent group's membership is checked
      // via a get() call.
      match /bills/{billId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.member_ids;

        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.member_ids
          && request.resource.data.created_by is map
          && request.resource.data.created_by.id == request.auth.uid;

        allow update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.member_ids;

        allow delete: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.member_ids;
      }
    }


    // -------------------------
    // DEFAULT DENY
    // -------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
